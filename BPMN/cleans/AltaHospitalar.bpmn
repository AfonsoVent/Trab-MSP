    <bpmn:dataObject id="Obj_DO_Alta" />
    <bpmn:dataStoreReference id="DS_Proc2" name="Processo Clínico do Idoso" />
    <bpmn:startEvent id="Start" name="Decisão de Alta Recebida">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_VerClin" name="Verificar Pendências Clínicas, Exames e Medicação">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:property id="Prop_T_VerClin" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_T_VerClin_DO_Rel">
        <bpmn:sourceRef>DO_Rel</bpmn:sourceRef>
        <bpmn:targetRef>Prop_T_VerClin</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DIA_T_VerClin_DS_Proc1">
        <bpmn:sourceRef>DS_Proc1</bpmn:sourceRef>
        <bpmn:targetRef>Prop_T_VerClin</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T_PedAdm" name="Pedir Validação de Checkout à Administração">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="T_RecAdm" name="Receber Resultado da Validação">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="G_Pend" name="Pendências detetadas?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F_Sim</bpmn:outgoing>
      <bpmn:outgoing>F_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_NotPend" name="Notificar Médico e Enfermeiro das Pendências">
      <bpmn:incoming>F_Sim</bpmn:incoming>
      <bpmn:outgoing>F_Susp</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_Susp" name="Alta Suspensa">
      <bpmn:incoming>F_Susp</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_Estado" name="Atualizar Estado do Utente para ALTA">
      <bpmn:incoming>F_Nao</bpmn:incoming>
      <bpmn:outgoing>G0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T_PedEnf" name="Notificar Enfermeiro: Executar Atividades Pré-Alta">
      <bpmn:incoming>G0</bpmn:incoming>
      <bpmn:outgoing>G1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="T_RecEnf" name="Receber Confirmação das Atividades Pré-Alta">
      <bpmn:incoming>G1</bpmn:incoming>
      <bpmn:outgoing>G2</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="T_GerDoc" name="Criação do Documento de ALTA">
      <bpmn:incoming>G2</bpmn:incoming>
      <bpmn:outgoing>G3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_T_GerDoc_DO_Alta">
        <bpmn:targetRef>DO_Alta</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T_PedAss" name="Enviar Documento de ALTA ao Médico para Assinatura">
      <bpmn:incoming>G3</bpmn:incoming>
      <bpmn:outgoing>G4</bpmn:outgoing>
      <bpmn:property id="Prop_T_PedAss" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_T_PedAss_DO_Alta">
        <bpmn:sourceRef>DO_Alta</bpmn:sourceRef>
        <bpmn:targetRef>Prop_T_PedAss</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:receiveTask id="T_RecAss" name="Receber Documento de ALTA Assinado">
      <bpmn:incoming>G4</bpmn:incoming>
      <bpmn:outgoing>G5</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="T_Receitas" name="Enviar Receitas e Recomendações ao Idoso">
      <bpmn:incoming>G5</bpmn:incoming>
      <bpmn:outgoing>G6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="T_Hist" name="Registar no Histórico do Idoso">
      <bpmn:incoming>G6</bpmn:incoming>
      <bpmn:outgoing>G7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_T_Hist_DS_Proc2">
        <bpmn:targetRef>DS_Proc2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Arq" name="Arquivar Processo Clínico">
      <bpmn:incoming>G7</bpmn:incoming>
      <bpmn:outgoing>G8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_T_Arq_DS_Proc2">
        <bpmn:targetRef>DS_Proc2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Desat" name="Desativar Caso Atual do Idoso">
      <bpmn:incoming>G8</bpmn:incoming>
      <bpmn:outgoing>G9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_Done" name="Checkout Concluído">
      <bpmn:incoming>G9</bpmn:incoming>
    </bpmn:endEvent>
