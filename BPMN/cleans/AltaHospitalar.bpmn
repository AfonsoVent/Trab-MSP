  <bpmn:process id="Process_CPS" isExecutable="false">
    <bpmn:dataObjectReference id="DO_Rel" name="Relatório do Idoso" dataObjectRef="Obj_DO_Rel" />
    <bpmn:dataObject id="Obj_DO_Rel" />
    <bpmn:dataStoreReference id="DS_Proc1" name="Processo Clínico do Idoso" />
