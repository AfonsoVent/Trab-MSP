    <bpmn:sequenceFlow id="F15" name="Sim" sourceRef="G_MedOK" targetRef="G_OkMerge" />
    <bpmn:sequenceFlow id="F16" sourceRef="G_RejMerge" targetRef="T_NotRej" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_NotRej" targetRef="E_Rej" />
    <bpmn:sequenceFlow id="F18" sourceRef="G_OkMerge" targetRef="T_Registar" />
