    <bpmn:messageFlow id="M1" name="Pedido de formulário" sourceRef="T_PedirForm" targetRef="Participant_1ys1haz" />
    <bpmn:messageFlow id="M2" name="Formulário preenchido" sourceRef="Participant_1ys1haz" targetRef="T_RecForm" />
    <bpmn:messageFlow id="M3" name="Rejeição + motivo" sourceRef="T_NotRej" targetRef="Participant_1ys1haz" />
    <bpmn:messageFlow id="M4" name="Aprovação" sourceRef="T_NotOk" targetRef="Participant_1ys1haz" />
    <bpmn:messageFlow id="M5" name="Formulário + histórico clínico" sourceRef="T_PedirMed" targetRef="Participant_16ck489" />
    <bpmn:messageFlow id="M6" name="Decisão + observações" sourceRef="Participant_16ck489" targetRef="T_RecMed" />
    <bpmn:messageFlow id="M7" name="Pedido de refeição" sourceRef="T_PedirEnf" targetRef="Participant_15rqmnp" />
    <bpmn:messageFlow id="M8" name="Confirmação de entrega" sourceRef="Participant_15rqmnp" targetRef="T_RecEnf" />
  </bpmn:collaboration>
  <bpmn:process id="Process_CPS" isExecutable="false">
    <bpmn:dataObjectReference id="DO_Form" name="Formulário do Idoso" dataObjectRef="DataObject_Form" />
    <bpmn:dataObject id="DataObject_Form" />
    <bpmn:dataStoreReference id="DS_Hist1" name="Histórico Clínico do Idoso" />
    <bpmn:dataStoreReference id="DS_Hist2" name="Histórico Clínico do Idoso" />
    <bpmn:startEvent id="Start" name="Necessidade de Refeição Especial">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="T_PedirForm" name="Solicitar Formulário (Alergias, Dieta)">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="T_RecForm" name="Receber Formulário Preenchido">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_Form">
        <bpmn:targetRef>DO_Form</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="T_Validar" name="Validar Dados do Formulário">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Completo" name="Dados completos?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Verificar" name="Verificar Restrições com Histórico Clínico e Prescrição">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:property id="Prop_Ver" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_Hist1">
        <bpmn:sourceRef>DS_Hist1</bpmn:sourceRef>
        <bpmn:targetRef>Prop_Ver</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Compat" name="Restrições compatíveis com a prescrição?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_Sev" name="Severidade da restrição?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_PedirMed" name="Solicitar Validação Médica">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="T_RecMed" name="Receber Decisão Médica">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="G_MedOK" name="Aprovado pelo médico?">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_RejMerge" name="">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_NotRej" name="Notificar Utente: Pedido Rejeitado">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_Rej" name="Pedido Rejeitado">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_OkMerge" name="">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Registar" name="Registar Refeição na Ementa Diária">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Guardar" name="Guardar no Histórico do Idoso">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_Hist2">
        <bpmn:targetRef>DS_Hist2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T_NotOk" name="Notificar Utente: Pedido Aprovado">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="T_PedirEnf" name="Notificar Enfermagem: Preparar Refeição Especial">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="T_RecEnf" name="Receber Confirmação de Entrega">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="E_Done" name="Refeição Entregue ao Idoso">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_PedirForm" />
    <bpmn:sequenceFlow id="F5" name="Não" sourceRef="G_Completo" targetRef="T_PedirForm" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_PedirForm" targetRef="T_RecForm" />
